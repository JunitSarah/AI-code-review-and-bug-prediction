# Model path: local artifacts folder or Hugging Face repo id (e.g. yourname/codebert-defect)
MODEL_PATH=artifacts/codebert-defect

# Optional GitHub token for higher rate limits when analyzing public PRs
GITHUB_TOKEN=

# LLM review: "openai_compatible" (Gemini, Groq, OpenRouter, Ollama) or "anthropic"
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=openai/gpt-oss-120b

# CORS, quantisation and threshold settings
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
QUANTIZE=1
# RISK_THRESHOLD=0.58
